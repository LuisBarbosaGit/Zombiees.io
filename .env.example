# Vite: use only the Supabase publishable key here; never put a service-role key in VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_GAME_API_URL=http://127.0.0.1:3001/api
VITE_GAME_WS_URL=ws://127.0.0.1:3001/ws/game

# NestJS authoritative game server. Prefer Supabase's direct/session pooler connection.
SUPABASE_URL=
DATABASE_URL=
DATABASE_SSL=true
WEB_ORIGIN=http://127.0.0.1:5173
PORT=3001
# Optional absolute or cwd-relative path; defaults to the checked-in map.
# GAME_MAP_FILE=
